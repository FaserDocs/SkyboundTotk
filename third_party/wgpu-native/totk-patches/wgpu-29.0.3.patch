+/// WGPU_HAL_STATS=1 (TOTK port, measurement): time spent in driver calls that happen once per command buffer or
+/// render pass, printed to stderr every 5 s (per second).
+pub(super) mod hal_stats {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    use std::sync::OnceLock;
+    use std::time::Instant;
+    use std::string::String;
+    pub const CREATE_FB: usize = 0;
+    pub const DESTROY_FB: usize = 1;
+    pub const ALLOC_CB: usize = 2;
+    pub const BEGIN_CB: usize = 3;
+    pub const END_CB: usize = 4;
+    pub const RESET_POOL: usize = 5;
+    pub const BEGIN_RP: usize = 6;
+    pub const END_RP: usize = 7;
+    const NAMES: [&str; 8] = [
+        "create_framebuffer", "destroy_framebuffer", "allocate_command_buffers", "begin_command_buffer",
+        "end_command_buffer", "reset_command_pool", "cmd_begin_render_pass", "cmd_end_render_pass",
+    ];
+    static NS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+    static N: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    fn epoch() -> &'static Instant {
+        static E: OnceLock<Instant> = OnceLock::new();
+        E.get_or_init(Instant::now)
+    }
+    pub fn on() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("WGPU_HAL_STATS").is_some())
+    }
+    pub fn add(i: usize, t0: Instant) {
+        NS[i].fetch_add(t0.elapsed().as_nanos() as u64, Relaxed);
+        N[i].fetch_add(1, Relaxed);
+        let now = epoch().elapsed().as_secs();
+        let last = LAST.load(Relaxed);
+        if now >= last + 5 && LAST.compare_exchange(last, now, Relaxed, Relaxed).is_ok() {
+            let secs = (now - last).max(1) as f64;
+            let mut line = String::new();
+            for k in 0..8 {
+                let ns = NS[k].swap(0, Relaxed);
+                let n = N[k].swap(0, Relaxed);
+                if n > 0 {
+                    line += &format!(" {} {:.0}/s {:.2} ms/s;", NAMES[k], n as f64 / secs, ns as f64 / 1e6 / secs);
+                }
+            }
+            eprintln!("[wgpu-hal stats]{line}");
+        }
+    }
+}
