+/// (TOTK port) The usage scope a pass will have, from its commands and attachments, applied to the command buffer's
+/// tracker and its barriers recorded into the open command buffer. False (nothing changed) when the scope does not
+/// merge: the pass then goes the usual way, which reports the error.
+fn pre_pass_barriers(
+    parent_state: &mut EncodingState<InnerCommandEncoder>,
+    device: &Arc<Device>,
+    base: &BasePass<ArcRenderCommand, Infallible>,
+    color_attachments: &ColorAttachments<Arc<TextureView>>,
+    depth_stencil_attachment: Option<&ResolvedRenderPassDepthStencilAttachment<Arc<TextureView>>>,
+) -> bool {
+    let mut scope = device.new_usage_scope();
+    let built = (|| -> Result<(), ResourceUsageCompatibilityError> {
+        for at in color_attachments.iter().flatten() {
+            unsafe {
+                scope.textures.merge_single(
+                    &at.view.parent,
+                    Some(at.view.selector.clone()),
+                    wgt::TextureUses::COLOR_TARGET,
+                )?;
+            }
+            if let Some(ref resolve) = at.resolve_target {
+                unsafe {
+                    scope.textures.merge_single(
+                        &resolve.parent,
+                        Some(resolve.selector.clone()),
+                        wgt::TextureUses::COLOR_TARGET,
+                    )?;
+                }
+            }
+        }
+        if let Some(ds) = depth_stencil_attachment {
+            let usage = if ds.depth.is_readonly()
+                && ds.stencil.is_readonly()
+                && device
+                    .downlevel
+                    .flags
+                    .contains(wgt::DownlevelFlags::READ_ONLY_DEPTH_STENCIL)
+            {
+                wgt::TextureUses::DEPTH_STENCIL_READ | wgt::TextureUses::RESOURCE
+            } else {
+                wgt::TextureUses::DEPTH_STENCIL_WRITE
+            };
+            unsafe {
+                scope
+                    .textures
+                    .merge_single(&ds.view.parent, Some(ds.view.selector.clone()), usage)?;
+            }
+        }
+        for command in base.commands.iter() {
+            match command {
+                ArcRenderCommand::SetBindGroup {
+                    bind_group: Some(bind_group),
+                    ..
+                } => unsafe { scope.merge_bind_group(&bind_group.used)? },
+                ArcRenderCommand::SetIndexBuffer { buffer, .. } => {
+                    scope.buffers.merge_single(buffer, wgt::BufferUses::INDEX)?
+                }
+                ArcRenderCommand::SetVertexBuffer { buffer, .. } => {
+                    scope.buffers.merge_single(buffer, wgt::BufferUses::VERTEX)?
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    })();
+    if built.is_err() {
+        return false;
+    }
+    let indices = &device.tracker_indices;
+    parent_state.tracker.buffers.set_size(indices.buffers.size());
+    parent_state.tracker.textures.set_size(indices.textures.size());
+    let Ok(raw) = parent_state.raw_encoder.open_if_closed() else {
+        return false;
+    };
+    CommandEncoder::insert_barriers_from_scope(raw, parent_state.tracker, &scope, parent_state.snatch_guard);
+    true
+}
